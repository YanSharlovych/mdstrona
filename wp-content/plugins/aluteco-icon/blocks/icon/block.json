{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "aluteco/icon",
  "version": "1.1.0",
  "title": "ALUTECO Icon",
  "category": "media",
  "icon": "star-filled",
  "description": "Visual SVG icon library with secure custom uploads.",
  "textdomain": "aluteco-icon",
  "attributes": {
    "icon": {
      "type": "string",
      "default": "consultation"
    },
    "ariaLabel": {
      "type": "string",
      "default": ""
    },
    "customSvg": {
      "type": "string",
      "default": ""
    },
    "customFileName": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right"],
    "color": {
      "text": true,
      "background": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "aluteco-icon-plugin-editor",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css"
}
